+// iOS 上 daemon 是 launchd 直接拉的，ppid 恒为 1，路径才是判断「是不是另一份实例」的关键。
+func exePath() string {
+	p, err := os.Executable()
+	if err != nil {
+		return "?"
+	}
+	return p
