+
+// panelRootRedirect 把根路径跳到面板目录，保留查询串（?minis=1 之类）。
+func panelRootRedirect(w http.ResponseWriter, r *http.Request) {
+	target := "/panel/"
+	if r.URL.RawQuery != "" {
+		target += "?" + r.URL.RawQuery
+	}
+	http.Redirect(w, r, target, http.StatusFound)
 }
 
